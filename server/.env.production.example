# ==============================================================================
# Production Backend API Environment Template (server/.env.production.example)
# Use these environment variables when deploying to Render / Railway / Heroku
# ==============================================================================

PORT=10000
NODE_ENV=production
TRUST_PROXY=true
ALLOWED_ORIGIN=*

# Supabase Server Admin Connection (Service Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Monime Mobile Money & Card Payments Gateway
MONIME_API_BASE_URL=https://api.monime.io
MONIME_API_VERSION=caph.2025-08-23
MONIME_SECRET_KEY=your_monime_secret_key_here
MONIME_SPACE_ID=your_monime_space_id_here
APP_BASE_URL=https://your-backend.onrender.com/
MONIME_WEBHOOK_SECRET=your_monime_webhook_secret_here
MONIME_WEBHOOK_SIGNATURE_HEADER=x-monime-signature

# Resend Email Delivery Service
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=EduLink <onboarding@resend.dev>

# OneSignal Push Notifications (Mobile PWA & Web)
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here

# Web Push Notifications (VAPID Fallback)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=admin@yourdomain.com

# GPS Geofencing Settings (MMTU Goderich Main Campus: 8.42431, -13.28477)
DEFAULT_CAMPUS_LAT=8.42431
DEFAULT_CAMPUS_LNG=-13.28477
MAX_ATTENDANCE_RADIUS_METERS=150
TIME_WINDOW_MINUTES_BEFORE_END=30
