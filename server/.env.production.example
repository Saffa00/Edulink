# Production Backend API Environment Configuration
# Copy this file to server/.env or set these in your server hosting platform (e.g., Render, Railway, AWS ECS)

# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGIN=https://portal.youruniversity.edu

# Supabase Admin / Service Role (Authoritative Backend Operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Monime Payments Gateway (Live Credentials)
MONIME_API_KEY=your_monime_api_key_here
MONIME_SPACE_ID=your_monime_space_id_here
MONIME_WEBHOOK_SECRET=your_monime_webhook_secret_here
MONIME_BASE_URL=https://api.monime.io/v1

# Push Notification Service (Web Push VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:sysadmin@youruniversity.edu

# GPS & Geofencing Parameters
DEFAULT_CAMPUS_LAT=6.4698
DEFAULT_CAMPUS_LNG=3.5852
MAX_ATTENDANCE_RADIUS_METERS=150
TIME_WINDOW_MINUTES_BEFORE_END=30
