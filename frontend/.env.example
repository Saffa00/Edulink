# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT (.env.example)
# Vite SPA / PWA - Academic Management & Lecturer Portal
# ==============================================================================

# Supabase Public API (Accessible by browser client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Authoritative Backend API Base URL (Live Render URL or http://localhost:4000 locally)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Monime Payments Public Space ID
VITE_MONIME_SPACE_ID=your_monime_space_id_here

# OneSignal Web Push App ID
VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here

# Push Notification Public Key (VAPID Fallback)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# App Environment
VITE_APP_ENV=production
